NODE_ENV=development
PORT=5000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ehr_eprescription
DB_USER=ehr_app
DB_PASSWORD=replace_me

FRONTEND_URL=http://localhost:5174


JWT_ACCESS_SECRET=SECRET_KEY_REPLACE_ME

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

REFRESH_COOKIE_NAME=ehr_refresh_token

BCRYPT_SALT_ROUNDS=12

LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10

# Optional — only used by `npm run seed` to set known passwords
# instead of randomly generated ones. Never commit real values.
# SEED_ADMIN_PASSWORD=
# SEED_DOCTOR_PASSWORD=
# SEED_PHARMACIST_PASSWORD=
# SEED_PATIENT_PASSWORD=